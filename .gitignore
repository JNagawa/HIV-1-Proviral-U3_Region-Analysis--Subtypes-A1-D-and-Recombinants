# ============================================================================
#  .gitignore for HIV U3 analysis QC pipeline
#  Keeps: scripts (*.sh), environment (*.yml), README, small config/text files
#  Ignores: raw/processed sequence data, QC outputs, logs, SRA caches
# ============================================================================

# ----------------------------------------------------------------------------
#  Sequence data
# ----------------------------------------------------------------------------
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra
*.bam
*.bai
*.sam
*.cram
*.fasta
*.fa
*.fa.gz
*.fna
*.vcf
*.vcf.gz

# ----------------------------------------------------------------------------
#  Data directories created by the scripts
# ----------------------------------------------------------------------------
# Nanopore pipeline (qc_u3analyis.sh)
data/raw/oxnano/
data/processed/oxnano/filtered/

# Illumina pipeline (qc_illumina_u3analysis.sh)
data/raw/illumina/
data/processed/illumina/trimmed/

# SRA prefetch caches (in case the default ~/ncbi location is used)
ncbi/
sra/

# ----------------------------------------------------------------------------
#  QC tool outputs (regenerable — no need to track)
# ----------------------------------------------------------------------------
# FastQC
*_fastqc.zip

# ----------------------------------------------------------------------------
#  Logs (see note below about keeping the empty logs/ directory)
# ----------------------------------------------------------------------------
logs/*
!logs/.gitkeep
slurm-*.out
slurm-*.err
*.log

# ----------------------------------------------------------------------------
#  tool_comparison harness -- third-party clones/downloads (regenerable via
#  each stage's setup_*.sh) and per-tool run outputs. summary.tsv and
#  ease_of_use_notes.md are the actual deliverables and are NOT matched by
#  any rule below, so they stay tracked.
# ----------------------------------------------------------------------------
scripts/tool_comparison/04_biological_filtering/tools/
scripts/tool_comparison/05_subtyping/tools/
scripts/tool_comparison/06_motif_mapping/jaspar/
results/tool_comparison/**/*_out
results/tool_comparison/**/*_out.*
results/tool_comparison/**/*_positive_control*
results/tool_comparison/**/*.time

# ----------------------------------------------------------------------------
#  Environment / editor / OS cruft
# ----------------------------------------------------------------------------
__pycache__/
*.pyc
.conda/
.snakemake/
.DS_Store
*.swp
*~
.vscode/
.idea/
scripts/tools/shiver/
Internship/
test_tools.sh variant_call.sh *.docx
