# ============================================================================
#  .gitignore for HIV U3 analysis QC pipeline
#  Keeps: scripts (*.sh), environment (*.yml), README, small config/text files
#  Ignores: raw/processed sequence data, QC outputs, logs, SRA caches
# ============================================================================

# ----------------------------------------------------------------------------
#  Sequence data
# ----------------------------------------------------------------------------
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra
*.bam
*.bai
*.sam
*.cram
*.fasta
*.fa
*.fa.gz
*.fna
*.vcf
*.vcf.gz

# ----------------------------------------------------------------------------
#  Data directories created by the scripts
# ----------------------------------------------------------------------------
# Nanopore pipeline (qc_u3analyis.sh)
data/raw/oxnano/
data/processed/oxnano/filtered/

# Illumina pipeline (qc_illumina_u3analysis.sh)
data/raw/illumina/
data/processed/illumina/trimmed_trimmomatic/
data/processed/illumina/trimmed_fastp/

# SRA prefetch caches (in case the default ~/ncbi location is used)
ncbi/
sra/

# ----------------------------------------------------------------------------
#  QC tool outputs (regenerable — no need to track)
# ----------------------------------------------------------------------------
# FastQC
*_fastqc.zip

# ----------------------------------------------------------------------------
#  Logs (see note below about keeping the empty logs/ directory)
# ----------------------------------------------------------------------------
logs/*
!logs/.gitkeep
slurm-*.out
slurm-*.err
*.log

# ----------------------------------------------------------------------------
#  Tool comparison harness -- third-party clones/downloads (regenerable via
#  each step's setup_*.sh) and per-tool run outputs. summary.tsv and
#  ease_of_use_notes.md are the actual deliverables and are NOT matched by
#  any rule below, so they stay tracked. scripts/tools/shiver/ is covered
#  further down alongside the other scripts/tools/* third-party clones.
# ----------------------------------------------------------------------------
scripts/tools/Poplars/
scripts/tools/HIVSeqinR/
scripts/tools/HIVIntact/
scripts/tools/jpHMM/
data/reference/jaspar/
results/download_qc/illumina/**/*_out
results/download_qc/illumina/**/*_out.*
results/assembly/illumina/**/*_out
results/assembly/illumina/**/*_out.*
results/msa/illumina/**/*_out
results/msa/illumina/**/*_out.*
results/biological_filtering/illumina/**/*_out
results/biological_filtering/illumina/**/*_out.*
results/subtyping/illumina/**/*_out
results/subtyping/illumina/**/*_out.*
results/motif_mapping/illumina/**/*_out
results/motif_mapping/illumina/**/*_out.*
results/motif_mapping/illumina/**/*_positive_control*
results/download_qc/illumina/**/*.time
results/assembly/illumina/**/*.time
results/msa/illumina/**/*.time
results/biological_filtering/illumina/**/*.time
results/subtyping/illumina/**/*.time
results/motif_mapping/illumina/**/*.time
results/download_qc/oxfordnano/**/*_out
results/download_qc/oxfordnano/**/*_out.*
results/assembly/oxfordnano/**/*_out
results/assembly/oxfordnano/**/*_out.*
results/msa/oxfordnano/**/*_out
results/msa/oxfordnano/**/*_out.*
results/biological_filtering/oxfordnano/**/*_out
results/biological_filtering/oxfordnano/**/*_out.*
results/subtyping/oxfordnano/**/*_out
results/subtyping/oxfordnano/**/*_out.*
results/motif_mapping/oxfordnano/**/*_out
results/motif_mapping/oxfordnano/**/*_out.*
results/motif_mapping/oxfordnano/**/*_positive_control*
results/download_qc/oxfordnano/**/*.time
results/assembly/oxfordnano/**/*.time
results/msa/oxfordnano/**/*.time
results/biological_filtering/oxfordnano/**/*.time
results/subtyping/oxfordnano/**/*.time
results/motif_mapping/oxfordnano/**/*.time

# ----------------------------------------------------------------------------
#  Environment / editor / OS cruft
# ----------------------------------------------------------------------------
__pycache__/
*.pyc
.conda/
.snakemake/
.DS_Store
*.swp
*~
.vscode/
.idea/
scripts/tools/shiver/
Internship/
test_tools.sh variant_call.sh *.docx
